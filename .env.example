# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
ALLOWED_USER_IDS=7053417982,YOUR_OTHER_USER_ID

# Cline Configuration
CLINE_API_URL=http://localhost:3000
CLINE_API_KEY=your_cline_api_key_here

# Bot Settings
BOT_LOG_LEVEL=INFO
BOT_TIMEOUT=30
BOT_RATE_LIMIT=10

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security
ENABLE_RATE_LIMITING=true
ENABLE_MESSAGE_SANITIZATION=true
SESSION_TIMEOUT_MINUTES=60
